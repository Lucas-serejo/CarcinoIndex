# Docker Compose reads .env; Python/Alembic read exported environment variables.
POSTGRES_DB=carcinoindex
POSTGRES_USER=carcinoindex
POSTGRES_PASSWORD=local-experiment-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://carcinoindex:local-experiment-only@127.0.0.1:5432/carcinoindex
STORAGE_ROOT=./storage

# SAM 2.1: replace the example checkpoint path with your local file (outside the repository).
SAM2_CHECKPOINT_PATH=C:\path\to\sam2.1_hiera_small.pt
SAM2_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_s.yaml
SAM2_DEVICE=cuda
SAM2_DTYPE=float32

# Optional: dedicated disposable PostgreSQL database for integration tests.
# TEST_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/carcinoindex_test
